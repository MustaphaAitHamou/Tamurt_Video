# =============================================================================
# Tamurt Vidéo — variables d'environnement (modèle, sans aucune valeur secrète)
# -----------------------------------------------------------------------------
# Développement local : `pnpm db:start` puis `pnpm env:local` génère .env.local
# avec les clés de la pile Supabase LOCALE. Ne jamais committer de vraie clé.
# Production : renseigner ces variables dans Vercel (Settings › Environment
# Variables), jamais dans le code. Voir docs/SERVICES_SETUP.md.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# URL publique, sans barre finale (liens des emails, redirections, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de données, authentification, stockage) -------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clé publique (sb_publishable_…) : exposée au navigateur, protégée par la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) : SERVEUR UNIQUEMENT, contourne la RLS.
SUPABASE_SECRET_KEY=
# Connexion PostgreSQL directe, utilisée uniquement par les tests d'intégration locaux.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Connexion Google : n'activer qu'après configuration du fournisseur dans Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Paiements (Stripe) — MODE TEST UNIQUEMENT par défaut ----------------------
# Sans clé, les souscriptions en ligne sont désactivées (aucun paiement possible).
# Utiliser exclusivement des clés de test (sk_test_…). Une clé live est refusée
# tant que PAYMENTS_LIVE_MODE_ALLOWED n'est pas explicitement passé à true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Calcul automatique de la TVA par Stripe Tax (à activer après configuration fiscale).
STRIPE_AUTOMATIC_TAX=false
# Paiements réels : NE PAS ACTIVER sans validation explicite (juridique, fiscale, propriétaire).
PAYMENTS_LIVE_MODE_ALLOWED=false

# --- Diffusion vidéo -----------------------------------------------------------
# dev : médias de test locaux (pnpm media:dev). cloudflare : Cloudflare Stream.
STREAMING_PROVIDER=dev
# Secret des jetons du fournisseur de développement (dérivé de la clé Supabase si vide).
DEV_STREAM_SECRET=
# Le fournisseur de développement est refusé en production, sauf dérogation explicite.
ALLOW_DEV_STREAMING_IN_PRODUCTION=false
# Cloudflare Stream (intégration non testée en conditions réelles : voir docs/BLOCKERS.md).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
# Clé privée de signature (PEM ou base64 du PEM), fournie par l'API Stream « keys ».
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Ajoute une règle géographique au jeton de lecture (pays de la requête).
CLOUDFLARE_STREAM_GEO_LOCK=true
# Durée de validité des jetons de lecture (secondes, 2 h à 12 h appliqués).
PLAYBACK_TOKEN_TTL_SECONDS=14400

# --- Géolocalisation (droits territoriaux) -------------------------------------
# En-tête de pays fourni par l'hébergeur (Vercel : x-vercel-ip-country).
GEO_COUNTRY_HEADER=x-vercel-ip-country
# Développement uniquement (ignoré en production) : pays forcé, ex. FR ou DZ.
DEV_COUNTRY_OVERRIDE=FR

# --- Emails transactionnels -----------------------------------------------------
# console : journalise sans envoyer (défaut, aucun email réel). smtp | resend.
EMAIL_PROVIDER=console
EMAIL_FROM="Tamurt Vidéo <no-reply@tamurt.example>"
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# --- Exploitation ----------------------------------------------------------------
# Secret de la tâche quotidienne (/api/cron/daily) : Vercel l'envoie en Bearer.
CRON_SECRET=
# Sel de hachage des adresses IP dans les journaux (dérivé si vide).
LOG_HASH_SALT=
# Développement uniquement (ignoré en production).
RATE_LIMIT_DISABLED=false
# Origines supplémentaires de la politique CSP (séparées par des espaces), si besoin.
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=
# Affichage des langues en cours de traduction (brouillons signalés comme tels).
NEXT_PUBLIC_ENABLE_DRAFT_LOCALES=true

{
  "name": "tamurt-video",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx scripts/check-i18n.mts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project unit --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start",
    "db:start:ci": "supabase start -x studio,imgproxy,vector,logflare,supavisor,edge-runtime,realtime,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "env:local": "tsx scripts/write-local-env.mts",
    "seed:demo": "tsx scripts/seed-demo.mts",
    "media:dev": "tsx scripts/generate-dev-media.mts",
    "brand:generate": "tsx scripts/generate-brand.mts",
    "demo:art": "tsx scripts/generate-demo-art.mts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/noto-sans-tifinagh": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "1.9.0",
    "hls.js": "^1.7.4",
    "jose": "^6.2.14",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.3.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "23.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "supabase": "2.122.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "4.1.12"
  }
}
